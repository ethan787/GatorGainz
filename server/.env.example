# Copy to server/.env. Run commands from the repository root via npm workspaces.
PORT=3001

# Registration, login, and persistent sessions require PostgreSQL.
# These credentials match compose.yaml and are for local development only.
DATABASE_URL=postgresql://gatorgainz:gatorgainz_local@127.0.0.1:5432/gatorgainz

# In production set NODE_ENV=production (Secure cookies) and the public HTTPS origin.
# Leave AUTH_ORIGIN empty locally to accept the origin preserved by the Vite proxy.
AUTH_ORIGIN=

# Optional dedicated database for integration tests; never use production here.
# TEST_DATABASE_URL=postgresql://gatorgainz:gatorgainz_local@127.0.0.1:5432/gatorgainz_auth_test
