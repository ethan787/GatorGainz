{
  "name": "gatorgainz",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace server",
    "check": "npm run typecheck && npm test && npm run build",
    "db:setup": "npm run db:setup --workspace server",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
