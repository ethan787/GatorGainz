{
  "name": "gatorgainz",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspace server",
    "test:integration": "npm run test:integration --workspace server",
    "test:ci": "npm run test:ci --workspace server",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "check:ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci && npm run build",
    "db:setup": "npm run db:setup --workspace server",
    "db:seed": "npm run db:setup --workspace server -- --seed",
    "db:local:start": "node scripts/local-postgres.cjs start",
    "db:local:stop": "node scripts/local-postgres.cjs stop",
    "db:local:status": "node scripts/local-postgres.cjs status",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  }
}
